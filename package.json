{
  "name": "zolai-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio workbench for the live Zolai Core API",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force --pretty",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "vite build && bash scripts/deploy.sh"
  },
  "dependencies": {
