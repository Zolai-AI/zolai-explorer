# Zolai Explorer — local environment
#
# Copy to `.env.local`. NEVER commit a real key: `.env*` is git-ignored.
#
# The API key is entered in the app's "API key" dialog and stored in
# localStorage under `zolai.apiKey`. It is never sent anywhere except the
# Zolai Core API, never logged, and never bundled.

# Base path for the versioned API surface.
# Default (relative) keeps same-origin requests against https://api.zolai.space.
# Set an absolute URL only when running the app on a different host.
VITE_API_BASE=/api/v1

# Upstream host used by the Vite dev proxy (`bun run dev`).
ZOLAI_UPSTREAM=https://api.zolai.space